# ---------------------------------------------------------------------------
# Exemplo de variaveis de ambiente (NAO contem segredos reais)
# Copie para .env e ajuste os valores.
# ---------------------------------------------------------------------------

# Conexao com o PostgreSQL (banco de desenvolvimento)
DATABASE_URL="postgresql://clinic:clinic@localhost:5432/clinic_exams?schema=public"

# Banco usado exclusivamente pela suite de testes automatizados.
# E recriado a cada execucao (migrate reset) - nunca aponte para producao.
TEST_DATABASE_URL="postgresql://clinic:clinic@localhost:5432/clinic_exams_test?schema=public"

# Segredo para assinatura dos tokens JWT. Gere um valor aleatorio forte.
JWT_SECRET="troque-este-valor-por-um-segredo-aleatorio-de-32+caracteres"
JWT_EXPIRES_IN="8h"

# Porta da API
PORT=3333

# Origens permitidas no CORS (separadas por virgula)
CORS_ORIGIN="http://localhost:5173"

# Fuso horario de referencia da clinica (exibicao e geracao de horarios)
CLINIC_TIMEZONE="America/Sao_Paulo"
